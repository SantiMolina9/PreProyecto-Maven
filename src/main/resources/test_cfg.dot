digraph CFG_PDOM {
    rankdir=TB;
    fontname="Arial";
    node [fontname="Arial", fontsize=11];
    edge [fontname="Arial", fontsize=10];

    n0 [shape=circle, width=0.5, fixedsize=true, style=filled, fillcolor=green, label="ENTRY"];
    n1 [shape=doublecircle, width=0.5, fixedsize=true, style=filled, fillcolor=red, label="EXIT"];
    n2 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n2: x = 3\nPDOM: {n2, n3, n6, n7, n1}"];
    n3 [shape=diamond, style=filled, fillcolor=lightyellow, label="n3: y\nPDOM: {n3, n6, n7, n1}"];
    n4 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n4: z = (x + 1)\nPDOM: {n4, n6, n7, n1}"];
    n5 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n5: y = (x + z)\nPDOM: {n5, n6, n7, n1}"];
    n6 [shape=ellipse, style=filled, fillcolor=lightyellow, label="n6 (join)\nPDOM: {n6, n7, n1}"];
    n7 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n7: return z\nPDOM: {n7, n1}"];

    n0 -> n2;
    n2 -> n3;
    n3 -> n4 [label="True", color=darkgreen, fontcolor=darkgreen];
    n3 -> n5 [label="False", color=red, fontcolor=red];
    n4 -> n6;
    n5 -> n6;
    n6 -> n7;
    n7 -> n1;

    pdom_table [shape=plaintext, label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="2" BGCOLOR="lightgray"><B>Post-Dominadores (PDOM)</B></TD></TR>
        <TR><TD BGCOLOR="lightgray"><B>Nodo</B></TD><TD BGCOLOR="lightgray"><B>PDOM</B></TD></TR>
        <TR><TD>n0: ENTRY</TD><TD>{n0, n2, n3, n6, n7, n1}</TD></TR>
        <TR><TD>n1: EXIT</TD><TD>{n1}</TD></TR>
        <TR><TD>n2: x = 3</TD><TD>{n2, n3, n6, n7, n1}</TD></TR>
        <TR><TD>n3: y</TD><TD>{n3, n6, n7, n1}</TD></TR>
        <TR><TD>n4: z = (x + 1)</TD><TD>{n4, n6, n7, n1}</TD></TR>
        <TR><TD>n5: y = (x + z)</TD><TD>{n5, n6, n7, n1}</TD></TR>
        <TR><TD>n6 (join)</TD><TD>{n6, n7, n1}</TD></TR>
        <TR><TD>n7: return z</TD><TD>{n7, n1}</TD></TR>
        </TABLE>
    >];
}
