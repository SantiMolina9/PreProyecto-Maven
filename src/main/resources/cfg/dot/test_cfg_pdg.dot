digraph PDG {
    // Program Dependence Graph (CDG + DDG)
    rankdir=TB;
    fontname="Arial";
    node [fontname="Arial", fontsize=12];
    edge [fontname="Arial", fontsize=10];
    label="Program Dependence Graph (PDG)";
    labelloc=t;

    n0 [shape=circle, width=0.5, style=filled, fillcolor=green, label="ENTRY"];
    n1 [shape=doublecircle, width=0.5, style=filled, fillcolor=red, label="EXIT"];
    n2 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n2: x = 3"];
    n3 [shape=diamond, style=filled, fillcolor=lightyellow, label="n3: y"];
    n4 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n4: z = (x + 1)"];
    n5 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n5: y = (x + z)"];
    n6 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n6: return z"];

    // --- Dependencias de Control (CDG) ---
    n3 -> n4 [style=dashed, penwidth=1.5, label="True", color=darkgreen, fontcolor=darkgreen];
    n3 -> n5 [style=dashed, penwidth=1.5, label="False", color=red, fontcolor=red];

    // --- Dependencias de Datos (DDG) ---
    n2 -> n4 [style=dashed, color=darkorange, fontcolor=darkorange, penwidth=1.5, label="x"];
    n2 -> n5 [style=dashed, color=darkorange, fontcolor=darkorange, penwidth=1.5, label="x"];
    n4 -> n6 [style=dashed, color=darkorange, fontcolor=darkorange, penwidth=1.5, label="z"];
}
