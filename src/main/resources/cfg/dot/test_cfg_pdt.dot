digraph PDT {
    // Arbol de Post-Dominadores
    rankdir=TB;
    fontname="Arial";
    node [fontname="Arial", fontsize=12];
    edge [fontname="Arial", fontsize=10];
    label="Arbol de Post-Dominadores (PDT)";
    labelloc=t;

    n1 [shape=doublecircle, width=0.5, style=filled, fillcolor=red, label="EXIT"];
    n6 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n6: return z"];
    n3 [shape=diamond, style=filled, fillcolor=lightyellow, label="n3: y"];
    n4 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n4: z = (x + 1)"];
    n5 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n5: y = (x + z)"];
    n2 [shape=box, style="rounded,filled", fillcolor=lightblue, label="n2: x = 3"];
    n0 [shape=circle, width=0.5, style=filled, fillcolor=green, label="ENTRY"];

    n1 -> n6;
    n6 -> n3;
    n6 -> n4;
    n6 -> n5;
    n3 -> n2;
    n2 -> n0;
}
