/*
  Parser simplificado para la gramatica del ejercicio de CFG.

  Gramatica:
    Program    -> integer id ( ) { Statement }
    Statement  -> id = Expression ;
               | return Expression ;
               | if ( Expression ) { Statement } else { Statement }
               | while ( Expression ) { Statement }
               | Statement Statement
    Expression -> Value + Value | Value
    Value      -> id | number
*/

import java_cup.runtime.*;
import java.util.List;
import java.util.ArrayList;
import ast.nodes.expression.*;
import ast.nodes.program.FunctionDefNode;
import ast.nodes.program.ParamNode;
import ast.nodes.program.ProgramNode;
import ast.nodes.statement.*;

parser code {:
    public void report_error(String message, Object info) {
        if (info instanceof java_cup.runtime.Symbol) {
            java_cup.runtime.Symbol s = ((java_cup.runtime.Symbol) info);
            if (s.left >= 0) {
                System.err.println("Error de sintaxis en linea " + (s.left + 1) +
                                   ", columna " + (s.right + 1) + ": " + message);
                return;
            }
        }
        System.err.println("Error de sintaxis: " + message);
    }

    public void report_fatal_error(String message, Object info) {
        report_error(message, info);
        System.exit(1);
    }
:};

/* ========== Terminal symbols (tokens) ========== */
terminal           SEMI, ASSIGN;
terminal           PLUS;
terminal           LPAREN, RPAREN, LBRACE, RBRACE;
terminal           INTEGER, RETURN;
terminal           IF, ELSE, WHILE;
terminal Integer   NUMBER;
terminal String    ID;

/* ========== Non-terminal symbols ========== */
non terminal ProgramNode        program;
non terminal List               stmt_list;
non terminal StmtNode           stmt;
non terminal ExprNode           expr;
non terminal ExprNode           value;
non terminal IfStmtNode         if_stmt;
non terminal WhileStmtNode      while_stmt;

/* ========== Grammar Rules ========== */

/* Program -> integer id ( ) { Statement } */
program ::= INTEGER ID:name LPAREN RPAREN LBRACE stmt_list:s RBRACE
            {:
                List<StmtNode> statements = (List<StmtNode>) s;
                List<ParamNode> emptyParams = new ArrayList<ParamNode>();
                FunctionDefNode func = new FunctionDefNode(
                    nameleft, nameright, "integer", name, emptyParams, statements);
                RESULT = new ProgramNode(nameleft, nameright, func);
            :}
            ;

/* stmt_list -> stmt_list stmt | stmt */
stmt_list ::= stmt_list:sl stmt:s
              {:
                  List<StmtNode> list = (List<StmtNode>) sl;
                  list.add(s);
                  RESULT = list;
              :}
              |
              stmt:s
              {:
                  List<StmtNode> list = new ArrayList<StmtNode>();
                  list.add(s);
                  RESULT = list;
              :}
              ;

/* Statement -> id = Expression ;
             | return Expression ;
             | if_stmt
             | while_stmt
*/
stmt ::= ID:id ASSIGN expr:e SEMI
         {:
             RESULT = new AssignmentNode(idleft, idright, id, e);
         :}
         |
         RETURN:r expr:e SEMI
         {:
             RESULT = new ReturnStmtNode(rleft, rright, e);
         :}
         |
         if_stmt:s
         {:
             RESULT = s;
         :}
         |
         while_stmt:s
         {:
             RESULT = s;
         :}
         ;

/* if ( Expression ) { Statement } else { Statement } */
if_stmt ::= IF:i LPAREN expr:cond RPAREN LBRACE stmt_list:then_stmts RBRACE
             ELSE LBRACE stmt_list:else_stmts RBRACE
             {:
                 RESULT = new IfStmtNode(ileft, iright, cond,
                     (List<StmtNode>) then_stmts, (List<StmtNode>) else_stmts);
             :}
             ;

/* while ( Expression ) { Statement } */
while_stmt ::= WHILE:w LPAREN expr:cond RPAREN LBRACE stmt_list:body RBRACE
               {:
                   RESULT = new WhileStmtNode(wleft, wright, cond,
                       (List<StmtNode>) body);
               :}
               ;

/* Expression -> Value + Value | Value */
expr ::= value:v1 PLUS:op value:v2
         {:
             RESULT = new BinaryOpNode(opleft, opright, v1,
                 BinaryOpNode.Operator.PLUS, v2);
         :}
         |
         value:v
         {:
             RESULT = v;
         :}
         ;

/* Value -> id | number */
value ::= ID:id
          {:
              RESULT = new VariableNode(idleft, idright, id);
          :}
          |
          NUMBER:n
          {:
              RESULT = new NumberNode(nleft, nright, n);
          :}
          ;
